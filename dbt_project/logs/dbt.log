    create  table
      "warehouse"."main"."int_lcdv2_hourly__dbt_tmp"
  
    as (
      with base as (
    select
        station,
        timestamp,
        dry_bulb_temp,
        wet_bulb_temp,
        dew_point_temp,
        relative_humidity,
        wind_speed,
        wind_direction,
        wind_gust_speed,
        precipitation,
        visibility,
        station_pressure,
        barometric_pressure
    from "warehouse"."main"."stg_lcdv2_hourly"
),

with_flags as (
    select
        *,
        
    (
        row_number() over (
            partition by station, date_trunc('hour', timestamp)
            order by timestamp desc
        ) = 1
    )
 as is_final,
        
    date_trunc('hour', timestamp)
 as floored_timestamp
    from base
),

aggregated as (
    select
        station,
        floored_timestamp,

        avg(dry_bulb_temp) as dry_bulb_temp,
        avg(wet_bulb_temp) as wet_bulb_temp,
        avg(dew_point_temp) as dew_point_temp,
        avg(relative_humidity) as relative_humidity,
        avg(wind_speed) as wind_speed,
        
(
    with angle as (
        select degrees(
            atan2(
                avg(sin(radians(wind_direction))),
                avg(cos(radians(wind_direction)))
            )
        ) as ang
    )
    select case 
        when ang < 0 then ang + 360
        else ang
    end
    from angle
)
 as wind_direction,
        max(wind_gust_speed) as wind_gust_speed,
        -- precipitation: final subhourly record only
        max(case when is_final then precipitation end) as precipitation,
        avg(visibility) as visibility,
        avg(station_pressure) as station_pressure,
        avg(barometric_pressure) as barometric_pressure

    from with_flags
    group by station, floored_timestamp
)

select * from aggregated
    );
  
  
