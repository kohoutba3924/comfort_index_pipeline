        edu_bachelors,
        edu_masters,
        edu_professional,
        edu_doctorate,
        poverty_universe,
        poverty_below,
        median_household_income,
        labor_force,
        labor_force_civilian,
        unemployment_civilian,
        housing_units,
        housing_occupied,
        housing_vacant,
        median_home_value,
