    create  table
      "warehouse"."main"."int_station_dim_enriched__dbt_tmp"
  
    as (
      with station as (
    select
        station,
        name,
        latitude,
        longitude,
        data_coverage,
        min_date,
        max_date
    from "warehouse"."main"."stg_lcdv2_station"
),

elev as (
    select
        station,
        elevation_m
    from "warehouse"."main"."stg_station_elevation"
)

select
    station.station,
    station.name,
    station.latitude,
    station.longitude,
    elev.elevation_m,
