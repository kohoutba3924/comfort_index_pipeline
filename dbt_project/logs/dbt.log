        centroid_lon,
        geometry_wkb
    from "warehouse"."main"."stg_tiger_tracts"
),

acs as (
    select
        tract,
        state_fips,
        county_fips,
        tract_code,
        population_total,
        population_male,
        population_female,
        male_65_66,
        male_67_69,
