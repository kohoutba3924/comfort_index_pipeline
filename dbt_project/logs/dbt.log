[0m21:25:45.153695 [debug] [Thread-3 (]: On model.ml_feature_pipeline.int_tract_station_distance: /* {"app": "dbt", "dbt_version": "1.11.11", "profile_name": "ml_feature_pipeline", "target_name": "dev", "node_id": "model.ml_feature_pipeline.int_tract_station_distance"} */

  
    
    

    create  table
      "warehouse"."main"."int_tract_station_distance__dbt_tmp"
  
    as (
      with stations as (
    select
        station,
        latitude as station_lat,
        longitude as station_lon,
        elevation_m as station_elev
    from "warehouse"."main"."int_station_dim_enriched"
),

tracts as (
    select
        tract,
        centroid_lat as tract_lat,
        centroid_lon as tract_lon,
        elevation_m as tract_elev
    from "warehouse"."main"."int_tract_dim_enriched"
),

cross_joined as (
    select
        s.station,
        t.tract,
        s.station_lat,
        s.station_lon,
        t.tract_lat,
        t.tract_lon,
        s.station_elev,
        t.tract_elev
    from stations s
    cross join tracts t
),

distance_calc as (
    select
        station,
        tract,

        -- geometry inputs
        station_lat,
        station_lon,
        tract_lat,
        tract_lon,
        station_elev,
        tract_elev,

        -- haversine distance (meters)
        
    (
        2 * 6371 * asin(
            sqrt(
                pow(sin(radians(tract_lat - station_lat) / 2), 2) +
                cos(radians(station_lat)) *
                cos(radians(tract_lat)) *
                pow(sin(radians(tract_lon - station_lon) / 2), 2)
            )
        )
    )
 as distance_m,

        -- bearing station → tract (degrees)
        
(
    with angles as (
        select
            radians(station_lat) as lat1_rad,
            radians(station_lon) as lon1_rad,
            radians(tract_lat) as lat2_rad,
            radians(tract_lon) as lon2_rad
    ),
    calc as (
        select
            lat1_rad,
            lon1_rad,
            lat2_rad,
            lon2_rad,
            (lon2_rad - lon1_rad) as delta_lon
        from angles
    ),
    bearing_raw as (
        select
            degrees(
                atan2(
                    sin(delta_lon) * cos(lat2_rad),
                    cos(lat1_rad) * sin(lat2_rad)
                    - sin(lat1_rad) * cos(lat2_rad) * cos(delta_lon)
                )
            ) as bearing_deg_raw
        from calc
    )
    select
        -- Normalize bearing to [0, 360)
        (bearing_deg_raw + 360) % 360 as bearing_deg
    from bearing_raw
)
 as bearing_deg,

        -- elevation difference (meters)
        (tract_elev - station_elev) as elevation_diff_m

    from cross_joined
)

select * from distance_calc
    );
  
  
