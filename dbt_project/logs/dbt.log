        housing_structure_universe,
        housing_1_unit,
        housing_2_unit,
        housing_3_4_unit,
        housing_5_9_unit,
        housing_10_19_unit,
        housing_20_49_unit,
        housing_50_plus_unit,
        housing_mobile_home
    from "warehouse"."main"."stg_acs_5yr"
),

elev as (
    select
        tract,
        elevation_m
    from "warehouse"."main"."stg_tract_elevation"
)

select
    tiger.tract,
    acs.state_fips,
    acs.county_fips,
    acs.tract_code,

    -- demographic fields

    acs.population_total,
    acs.population_male,
